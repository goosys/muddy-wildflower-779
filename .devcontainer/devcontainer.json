{
    "name": "Haikunator Workers",
    "dockerComposeFile": "compose.yaml",
    "postCreateCommand": "git config --global --add safe.directory ${containerWorkspaceFolder} && pnpm install --frozen-lockfile",
    "service": "app",
    "workspaceFolder": "/workspace",
    "remoteUser": "vscode",
    "forwardPorts": [
        5153, 8787
    ],
    "features": {
        "ghcr.io/devcontainers/features/node:1": {
            "version": "24.21.0",
            "pnpmVersion": "12.8.1",
            "nodeGypDependencies": false
        }
    }
}
