# Generated by Cargo
# will have compiled files and executables
debug/
target/

# include cargo lock
!Cargo.lock

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb
/target
# Workers build output and dependencies
/build/
/.assets/
/node_modules/
/.wrangler/
.pnpm-store/

# Operating system metadata
.DS_Store
._*
Thumbs.db
Desktop.ini

# Logs and editor temporary files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.swp
*.swo
*~

# Local environment and Wrangler secrets (keep examples trackable)
.env
.env.*
!.env.example
!.env.*.example
.dev.vars
.dev.vars.*
!.dev.vars.example
!.dev.vars.*.example
